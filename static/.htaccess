# .htaccess — kristoferhallen.com

# Använd vår anpassade 404-sida
ErrorDocument 404 /404.html

Options -Indexes

# --- 301: alternativt sitemap-namn som crawlers letar efter ---
Redirect 301 /sitemap_index.xml /sitemap.xml

# --- 403: skanningar efter WordPress/Joomla/andra CMS ---
# Direkt 403 utan Hugos 404-sida (eller startsidan) sparar bandbredd.
# Sajten är Hugo, så inga riktiga URL:er börjar med dessa sökvägar.
RedirectMatch 403 ^/(?:wp-admin|wp-content|wp-includes|wp-login\.php|wp-cron\.php|wp-config\.php|xmlrpc\.php|wordpress|wp|(?:blog|shop|test|new)/wp-[^/]*|joomla|administrator|media/system|components|modules|plugins|templates|phpmyadmin|portal|site|old|cms)(/|$)
# Dubbelsnedstreck-probes (//xmlrpc.php, //wp-includes/...)
RedirectMatch 403 ^//.*
# .env-skannrar
RedirectMatch 403 ^/\.env$
