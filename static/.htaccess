# .htaccess — kristoferhallen.com

# Använd vår anpassade 404-sida
ErrorDocument 404 /404.html

Options -Indexes

# --- Cache: webfonts change rarely; let browsers keep them for a year ---
# If a font file changes, give it a new name so caches pick it up.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# --- 301: alternativt sitemap-namn som crawlers letar efter ---
Redirect 301 /sitemap_index.xml /sitemap.xml

# --- 301: bytta post-slugs ---
RedirectMatch 301 ^/posts/mbc/?$ /posts/management-by-cookies/

# --- 403: skanningar efter WordPress/Joomla/andra CMS ---
# Direkt 403 utan Hugos 404-sida (eller startsidan) sparar bandbredd.
# Sajten är Hugo, så inga riktiga URL:er börjar med dessa sökvägar.
RedirectMatch 403 ^/(?:wp-admin|wp-content|wp-includes|wp-login\.php|wp-cron\.php|wp-config\.php|xmlrpc\.php|wordpress|wp|(?:blog|shop|test|new)/wp-[^/]*|joomla|administrator|media/system|components|modules|plugins|templates|phpmyadmin|portal|site|old|cms)(/|$)
# Dubbelsnedstreck-probes (//xmlrpc.php, //wp-includes/...)
RedirectMatch 403 ^//.*
# .env-skannrar
RedirectMatch 403 ^/\.env$
# Nyare skannrar (loggen okt 2026): molnnycklar, byggfiler, API- och adminprober.
# Ingen riktig sökväg på sajten börjar så (kontrollerat mot bygget 2026-10-21;
# webbmanifestet heter /site.webmanifest, inte manifest.json).
RedirectMatch 403 ^/(?:gcp-key|webpack-stats)\.json$
RedirectMatch 403 ^/(?:static/)?manifest\.json$
RedirectMatch 403 ^/(?:v1/|api/)?graphql/?$
RedirectMatch 403 ^/__vite_rsc_findSourceMapURL$
RedirectMatch 403 ^/(?:dashboard|console|admin|login|userfiles)(/|$)
RedirectMatch 403 ^/api/(?:designer|templates/preview)(/|$)
RedirectMatch 403 ^/read-document/?$

# --- Chrome Private Prefetch Proxy frågar efter /.well-known/traffic-advice ---
# Filen finns i static/.well-known/ ("[]" = inga begränsningar). Rätt
# Content-Type krävs, annars ignorerar Chrome den.
<Files "traffic-advice">
  ForceType application/trafficadvice+json
</Files>
